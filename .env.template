# NinjaOne → Jira Service Management Integration
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED must be set before the service will start.

# ─── NinjaOne ───────────────────────────────────────────────────────────────
# Create API credentials in NinjaOne: Administration > Apps > API > Add
NINJA_CLIENT_ID=            # REQUIRED
NINJA_CLIENT_SECRET=        # REQUIRED

# Override if using an EU/AU region instance
# NINJA_BASE_URL=https://app.ninjarmm.com

# ─── Jira ────────────────────────────────────────────────────────────────────
# Your Jira subdomain (e.g. "acme" for acme.atlassian.net)
JIRA_SUBDOMAIN=             # REQUIRED
JIRA_EMAIL=                 # REQUIRED  (your Atlassian account email)

# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=             # REQUIRED

# Discovered automatically on first run; paste here to skip re-discovery
# JIRA_WORKSPACE_ID=

# ─── Jira Assets schema (required for device sync) ──────────────────────────
# Found in Jira Assets → Settings → Object Schemas → your schema → Schema ID
# JIRA_ASSETS_SCHEMA_ID=

# ─── Jira Issues (required for alert → issue creation) ───────────────────────
# The Jira project key where alert issues will be created (e.g. "HELPDESK")
# JIRA_PROJECT_KEY=
# JIRA_ISSUE_TYPE_ID=

# ─── Schedules ───────────────────────────────────────────────────────────────
# How often to run a full device sync (hours, default: 6)
# NINJA_JIRA_SCHEDULE_INTERVAL_HOURS=6

# How often to poll for new alerts (minutes, default: 5)
# NINJA_JIRA_ALERT_SCHEDULE_INTERVAL_MINUTES=5

# Disable either scheduler independently
# NINJA_JIRA_SCHEDULE_ENABLED=true
# NINJA_JIRA_ALERT_SCHEDULE_ENABLED=true

# ─── Webhook server (only needed for run-server mode) ────────────────────────
# WEBHOOK_SECRET=
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080

# ─── Storage ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file (default: data/integration.db)
# DATABASE_PATH=data/integration.db

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
# NINJA_JIRA_LOG_FILE=logs/integration.log
